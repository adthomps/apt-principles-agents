{
  "title": "APT Principles and Agents Distribution Contract",
  "version": "1.0.0",
  "last_updated": "2026-06-28",
  "owner": "APT",
  "status": "active",
  "canonicalRepository": "apt-principles-agents",
  "ownership": {
    "canonical": [
      "principles",
      "standards",
      "checklists",
      "governance",
      "references",
      "context-packs",
      "skills",
      "agents",
      "templates",
      "prompts",
      "examples",
      "product-hubs",
      "manifests",
      "platform-adapters",
      "distribution-tooling"
    ],
    "targetOwned": [
      "product context",
      "architecture decisions",
      "commands and integrations",
      "local exceptions",
      "docs/project-context.md"
    ]
  },
  "manifestContract": {
    "directory": "manifests",
    "requiredFields": ["name", "description", "principles", "standards", "checklists", "context", "skills", "agents", "templates", "prompts", "platforms"],
    "optionalFields": ["extends"],
    "rules": [
      "Paths are repository-relative and cannot escape the canonical repository.",
      "Directories expand recursively in deterministic lexical order.",
      "Extensions are acyclic and duplicate entries are invalid."
    ]
  },
  "installationContract": {
    "path": ".apt/installation.json",
    "schema": "references/installation.schema.json",
    "rules": [
      "The target owns and commits the installation record.",
      "Managed files record canonical source, target path, artifact kind, and installed SHA-256.",
      "Sync preserves local drift unless force is explicit.",
      "Forced replacement writes a local timestamped backup before overwrite.",
      "Applied operations refresh source version, commit, hashes, and last operation."
    ]
  },
  "platformTargets": {
    "codex": ".codex/skills",
    "claude": ".claude/skills",
    "copilotSkills": ".github/skills",
    "copilotPrompts": ".github/prompts",
    "gemini": ".gemini/commands"
  },
  "retiredInterfaces": [
    ".agent-standards.json",
    ".agent-repo",
    "profiles/*.json",
    "install-agent-standards.mjs",
    "sync-agent-standards.mjs",
    "legacy lifecycle installers"
  ],
  "validation": [
    "npm run check",
    "node scripts/apt-assets.mjs audit-workspace --workspace-root .. --check"
  ]
}
