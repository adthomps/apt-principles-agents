{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apt.local/schemas/installation-v1.json",
  "title": "APT Installation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "manifests",
    "platforms",
    "managedFiles",
    "localContext",
    "lastOperation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "apt-principles-agents"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "codex",
          "claude",
          "copilot",
          "gemini",
          "cursor"
        ]
      },
      "uniqueItems": true
    },
    "managedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "kind",
          "sha256"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "canonical",
              "platform",
              "instruction",
              "platform-agent",
              "command",
              "hook"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "localContext": {
      "type": "string",
      "minLength": 1
    },
    "localTargets": {
      "type": "array",
      "description": "Repository-owned paths that a selected manifest would otherwise manage. install, sync and repair never write them (even with --force); scan reports them as local.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "lastOperation": {
      "type": "object",
      "required": [
        "type",
        "at"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "designVersion": {
      "type": "string",
      "pattern": "^d+.d+.d+$",
      "description": "design/VERSION synced into this repository (DR-015)."
    }
  }
}
