{
  "name": "apt-principles-agents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-repository.mjs",
    "validate:graphify": "node scripts/graphify-workspace.mjs audit",
    "validate:okf": "node scripts/validate-okf.mjs",
    "validate:metadata": "node scripts/normalize-metadata.mjs",
    "validate:parity": "node scripts/apt-assets.mjs check-parity",
    "validate:agents": "node scripts/validate-agents.mjs",
    "validate:adapters": "node scripts/build-agent-adapters.mjs --check",
    "validate:principle-links": "node scripts/build-principle-agent-links.mjs --check",
    "validate:council": "node scripts/run-council.mjs --self-test",
    "build:adapters": "node scripts/build-agent-adapters.mjs",
    "build:principle-links": "node scripts/build-principle-agent-links.mjs",
    "build:agents": "node scripts/build-principle-agent-links.mjs && node scripts/build-agent-adapters.mjs",
    "audit:workspace": "node scripts/apt-assets.mjs audit-workspace --workspace-root ..",
    "graphify:audit": "node scripts/graphify-workspace.mjs audit",
    "graphify:stage": "node scripts/graphify-workspace.mjs stage",
    "graphify:build:portfolio": "node scripts/graphify-workspace.mjs build portfolio",
    "graphify:views:portfolio": "node scripts/graphify-workspace.mjs views portfolio",
    "graphify:queries:portfolio": "node scripts/graphify-workspace.mjs queries portfolio",
    "scan:untracked-agents": "node scripts/scan-untracked-agents.mjs --workspace-root ..",
    "detect": "node scripts/apt-assets.mjs detect",
    "install": "node scripts/apt-assets.mjs install",
    "scan": "node scripts/apt-assets.mjs scan",
    "sync": "node scripts/apt-assets.mjs sync",
    "repair": "node scripts/apt-assets.mjs repair",
    "validate:ai": "node scripts/validate-ai-readiness.mjs",
    "validate:specialization": "node scripts/validate-content-specialization.mjs",
    "validate:project-profile": "node scripts/validate-project-profile.mjs --repo-root .",
    "inventory:generate": "node scripts/generate-project-inventory.mjs --mode repo --repo-root .",
    "inventory:check": "node scripts/generate-project-inventory.mjs --mode repo --repo-root . --check",
    "inventory:workspace": "node scripts/generate-project-inventory.mjs --mode workspace --workspace-root ..",
    "inventory:workspace:check": "node scripts/generate-project-inventory.mjs --mode workspace --workspace-root .. --check",
    "scaffold:audit-report": "node scripts/scaffold-apt-audit-report.mjs",
    "sweep:project-profiles": "node scripts/sweep-project-profiles.mjs",
    "test": "node scripts/test-installers.mjs && node scripts/test-project-inventory.mjs",
    "check": "npm run validate && npm run validate:graphify && npm run validate:okf && npm run validate:metadata && npm run validate:parity && npm run validate:agents && npm run validate:adapters && npm run validate:principle-links && npm run validate:council && npm run validate:specialization && npm run validate:project-profile && npm run inventory:check && npm run test"
  },
  "engines": {
    "node": ">=18"
  }
}
